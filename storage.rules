rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{all=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'oishe_admin@srbakery.app'
        && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
